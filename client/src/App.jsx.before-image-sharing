import { useCallback, useEffect, useRef, useState } from 'react';
import { io } from 'socket.io-client';
import { createRoomKey, decryptMessage, encryptMessage, importRoomKey } from './crypto.js';

const SERVER_URL = import.meta.env.VITE_SERVER_URL || 'http://localhost:4000';

function Icon({ name }) {
  const paths = {
    lock: <><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></>,
    plus: <><path d="M12 5v14M5 12h14"/></>,
    arrow: <><path d="M5 12h14M13 6l6 6-6 6"/></>,
    users: <><path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/><path d="M20 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></>,
    shield: <><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z"/><path d="m9 12 2 2 4-4"/></>,
    send: <><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></>,
    x: <><path d="m18 6-12 12M6 6l12 12"/></>,
    clock: <><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></>,
    copy: <><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/></>,
  };
  return <svg viewBox="0 0 24 24" aria-hidden="true" className="icon" fill="none" stroke="currentColor" strokeWidth="1.7" strokeLinecap="round" strokeLinejoin="round">{paths[name]}</svg>;
}

function getUrlDetails() {
  const url = new URL(window.location.href);
  const roomId = url.searchParams.get('room');
  const fragment = new URLSearchParams(url.hash.slice(1));
  return { roomId, keyString: fragment.get('key') };
}

export default function App() {
  const [view, setView] = useState('home');
  const [pin, setPin] = useState('');
  const [name, setName] = useState('');
  const [room, setRoom] = useState(null);
  const [roomKey, setRoomKey] = useState(null);
  const [inviteUrl, setInviteUrl] = useState('');
  const [messages, setMessages] = useState([]);
  const [draft, setDraft] = useState('');
  const [members, setMembers] = useState([]);
  const [error, setError] = useState('');
  const [busy, setBusy] = useState(false);
  const [copied, setCopied] = useState(false);
  const socketRef = useRef(null);
  const ownerTokenRef = useRef(null);
  const bottomRef = useRef(null);

  useEffect(() => {
    const { roomId, keyString } = getUrlDetails();
    if (roomId) {
      setRoom((current) => current || { id: roomId, creator: false });
      setView('join');
      if (keyString) {
        importRoomKey(keyString).then(setRoomKey).catch((err) => setError(err.message));
      } else {
        setError('This invite link has no encryption key. Ask the creator to send the full invite link.');
      }
    }
  }, []);

  useEffect(() => {
    bottomRef.current?.scrollIntoView({ behavior: 'smooth', block: 'end' });
  }, [messages]);

  const leaveSocket = useCallback(() => {
    socketRef.current?.disconnect();
    socketRef.current = null;
  }, []);

  const wipeLocal = useCallback((reason = 'ended') => {
    leaveSocket();
    setMessages([]);
    setMembers([]);
    setDraft('');
    setRoomKey(null);
    setRoom(null);
    ownerTokenRef.current = null;
    setInviteUrl('');
    setPin('');
    setName('');
    setView('ended');
    setError(reason === 'expired' ? 'This conversation expired after 30 minutes without activity.' : 'This conversation has been destroyed.');
    // Remove invite key and room id from the visible browser URL.
    window.history.replaceState({}, document.title, window.location.pathname);
  }, [leaveSocket]);

  const createRoom = async () => {
    setBusy(true); setError('');
    try {
      const response = await fetch(`${SERVER_URL}/api/rooms`, { method: 'POST' });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Could not create a room.');
      const generated = await createRoomKey();
      const url = new URL(window.location.href);
      url.search = '';
      url.hash = '';
      url.searchParams.set('room', data.roomId);
      url.hash = new URLSearchParams({ key: generated.encoded }).toString();
      ownerTokenRef.current = data.ownerToken;
      setRoom({ id: data.roomId, creator: true });
      setPin(data.pin);
      setRoomKey(generated.key);
      setInviteUrl(url.toString());
      setView('invite');
    } catch (err) {
      setError(err.message || 'Could not create a room.');
    } finally { setBusy(false); }
  };

  const joinRoom = async () => {
    setBusy(true); setError('');
    try {
      if (!/^\d{5}$/.test(pin)) throw new Error('Enter the five-digit room PIN.');
      if (!name.trim()) throw new Error('Choose a temporary display name.');
      let key = roomKey;
      if (!key) {
        const { keyString } = getUrlDetails();
        key = await importRoomKey(keyString);
        setRoomKey(key);
      }
      const response = await fetch(`${SERVER_URL}/api/rooms/join`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin }),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Could not join this room.');
      const { roomId: invitedRoomId } = getUrlDetails();
      if (invitedRoomId && invitedRoomId !== data.roomId) throw new Error('That PIN does not match this invitation link.');
      await connectToRoom(data.roomId, pin, name.trim(), key, false);
    } catch (err) {
      setError(err.message || 'Could not join this room.');
    } finally { setBusy(false); }
  };

  const connectToRoom = async (roomId, roomPin, displayName, key, creator) => {
    leaveSocket();
    const socket = io(SERVER_URL, { transports: ['websocket', 'polling'], auth: { clientVersion: 1 } });
    socketRef.current = socket;
    socket.on('connect_error', () => setError('Connection failed. Check the server and try again.'));
    socket.on('room:destroyed', ({ reason }) => wipeLocal(reason));
    socket.on('participant:joined', (person) => setMembers((current) => current.some((m) => m.id === person.id) ? current : [...current, person]));
    socket.on('participant:left', ({ id }) => setMembers((current) => current.filter((m) => m.id !== id)));
    socket.on('message:new', async (packet) => {
      try {
        const text = await decryptMessage(key, packet);
        setMessages((current) => current.some((m) => m.id === packet.id) ? current : [...current, { ...packet, text }]);
      } catch {
        setError('A message could not be decrypted. Confirm everyone has the same invitation link.');
      }
    });
    const joined = await new Promise((resolve, reject) => {
      socket.once('connect', () => {
        socket.emit('room:join', { roomId, pin: roomPin, name: displayName }, (result) => {
          if (result?.ok) resolve(result);
          else reject(new Error(result?.error || 'Could not join this room.'));
        });
      });
      socket.once('connect_error', () => reject(new Error('Could not connect to the chat server.')));
    });
    setRoom({ id: roomId, creator });
    setRoomKey(key);
    setMembers(joined.members || []);
    setMessages([]);
    setError('');
    setView('chat');
  };

  const sendMessage = async (event) => {
    event?.preventDefault();
    const text = draft.trim();
    if (!text || !socketRef.current || !roomKey) return;
    if (text.length > 2000) { setError('Messages must be 2,000 characters or fewer.'); return; }
    setDraft('');
    try {
      const encrypted = await encryptMessage(roomKey, text);
      socketRef.current.emit('message:send', encrypted, (result) => {
        if (!result?.ok) setError(result?.error || 'Message could not be sent.');
      });
    } catch { setError('Could not encrypt this message.'); }
  };

  const copyInvite = async () => {
    try {
      await navigator.clipboard.writeText(inviteUrl);
      setCopied(true);
      setTimeout(() => setCopied(false), 1800);
    } catch { setError('Clipboard access failed. Select and copy the invite link manually.'); }
  };

  const endRoom = async () => {
    if (!room?.creator || !ownerTokenRef.current) return;
    const confirmed = window.confirm(
      'End this HushRoom for everyone? All participants will be disconnected.'
    );
    if (!confirmed) return;
    setBusy(true);
    try {
      const response = await fetch(`${SERVER_URL}/api/rooms/${room.id}/end`, {
        method: 'POST', headers: { 'x-owner-token': ownerTokenRef.current },
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Could not end the room.');
      wipeLocal('ended');
    } catch (err) { setError(err.message || 'Could not end the room.'); }
    finally { setBusy(false); }
  };

  const backHome = () => {
    wipeLocal('ended');
    setView('home');
    setError('');
  };

  if (view === 'chat') {
    const sorted = [...messages].sort((a, b) => a.sentAt - b.sentAt);
    return <main className="app-shell chat-shell">
      <header className="chat-header">
        <button className="brand-button" onClick={backHome}><span className="brand-mark"><Icon name="lock"/></span><span>hushroom</span></button>
        <div className="header-status"><span className="status-dot"/> Encrypted session</div>
        <div className="room-actions">
          <button
            className="leave-button"
            onClick={backHome}
            disabled={busy}
            type="button"
          >
            Leave room
          </button>
          {room?.creator && (
            <button
              className="danger-button"
              onClick={endRoom}
              disabled={busy}
              type="button"
            >
              <Icon name="x"/> {busy ? 'Ending…' : 'End room for everyone'}
            </button>
          )}
        </div>
      </header>
      <section className="chat-layout">
        <aside className="side-panel">
          <div className="panel-label">YOUR ROOM</div>
          <div className="room-code">{pin || '•••••'}</div>
          <p className="muted small">Share the PIN separately from the invite link.</p>
          <div className="divider"/>
          <div className="panel-label"><Icon name="users"/> PEOPLE HERE <span className="count-pill">{members.length}</span></div>
          <div className="member-list">{members.map((member) => <div className="member" key={member.id}><span className="avatar">{(member.name || '?').slice(0,1).toUpperCase()}</span><span>{member.name}{member.id === socketRef.current?.id ? ' (you)' : ''}</span></div>)}</div>
          <div className="privacy-note"><Icon name="shield"/><div><strong>Private by design</strong><p>Messages are encrypted in your browser and are not saved as chat history.</p></div></div>
        </aside>
        <section className="conversation">
          <div className="conversation-top"><div><div className="panel-label">LIVE CONVERSATION</div><h1>Room is active</h1></div><div className="expiry"><Icon name="clock"/> 30 min inactivity expiry</div></div>
          <div className="message-list">
            {sorted.length === 0 && <div className="empty-chat"><div className="empty-icon"><Icon name="lock"/></div><h2>This is your quiet space.</h2><p>Messages are encrypted before they leave your device. Start the conversation when you're ready.</p></div>}
            {sorted.map((message) => <article className={`message ${message.senderId === socketRef.current?.id ? 'mine' : ''}`} key={message.id}><div className="message-meta"><strong>{message.senderName}</strong><time>{new Date(message.sentAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</time></div><p>{message.text}</p></article>)}
            <div ref={bottomRef}/>
          </div>
          {error && <div className="inline-error">{error}<button onClick={() => setError('')} aria-label="Dismiss">×</button></div>}
          <form className="composer" onSubmit={sendMessage}><input value={draft} onChange={(e) => setDraft(e.target.value)} maxLength={2000} placeholder="Write a message…" aria-label="Message" autoComplete="off"/><button className="send-button" type="submit" disabled={!draft.trim()} aria-label="Send message"><Icon name="send"/></button></form>
          <div className="composer-foot"><span><Icon name="shield"/> End-to-end encrypted</span><span>Messages aren't stored by HushRoom</span></div>
        </section>
      </section>
    </main>;
  }

  return <main className="app-shell">
    <header className="site-header">
      <button className="brand-button" onClick={backHome}><span className="brand-mark"><Icon name="lock"/></span><span>hushroom</span></button>
      <div className="header-note"><span className="status-dot"/> Temporary by design</div>
    </header>
    <section className="hero">
      <div className="eyebrow"><span className="eyebrow-line"/> A LITTLE SPACE, JUST FOR YOU</div>
      <h1>Some things are<br/><span>better said privately.</span></h1>
      <p className="hero-copy">Create a quiet room for a conversation. Invite the people you trust. When it's over, the room disappears.</p>
      <div className="hero-actions">
        <button className="primary-button" onClick={createRoom} disabled={busy}><Icon name="plus"/>{busy ? 'Creating…' : 'Create a private room'}</button>
        <button className="secondary-button" onClick={() => { setView('join'); setError(''); }}><Icon name="arrow"/> Join with a PIN</button>
      </div>
      {error && <div className="inline-error standalone">{error}<button onClick={() => setError('')} aria-label="Dismiss">×</button></div>}
      {view === 'invite' && room && <div className="invite-card">
        <div className="invite-top"><span className="success-mark"><Icon name="shield"/></span><div><strong>Your room is ready</strong><p>Send the invite link and share this PIN separately.</p></div></div>
        <label className="field-label">FIVE-DIGIT PIN</label>
        <div className="pin-display">{pin}</div>
        <label className="field-label">SECRET INVITE LINK</label>
        <div className="invite-link-row"><input readOnly value={inviteUrl} onFocus={(e) => e.target.select()} aria-label="Secret invite link"/><button className="copy-button" onClick={copyInvite}><Icon name="copy"/>{copied ? 'Copied' : 'Copy link'}</button></div>
        <button className="primary-button full-width" onClick={() => { setName(''); setView('join'); }}>Enter your room <Icon name="arrow"/></button>
        <p className="fine-print">Anyone with the full link can access the room key. Share it only with trusted people.</p>
      </div>}
      {view === 'join' && <form className="join-card" onSubmit={(e) => { e.preventDefault(); joinRoom(); }}>
        <div className="join-title"><span className="join-icon"><Icon name="lock"/></span><div><strong>Join a conversation</strong><p>Use the five-digit PIN you were given.</p></div></div>
        <label className="field-label" htmlFor="pin">ROOM PIN</label>
        <input id="pin" className="pin-input" inputMode="numeric" pattern="[0-9]{5}" maxLength={5} value={pin} onChange={(e) => setPin(e.target.value.replace(/\D/g, '').slice(0,5))} placeholder="00000" autoComplete="off" required/>
        <label className="field-label" htmlFor="displayName">TEMPORARY DISPLAY NAME</label>
        <input id="displayName" className="text-input" value={name} onChange={(e) => setName(e.target.value.slice(0,24))} placeholder="e.g. Alex" maxLength={24} autoComplete="off" required/>
        {error && <div className="inline-error">{error}<button type="button" onClick={() => setError('')} aria-label="Dismiss">×</button></div>}
        <button className="primary-button full-width" type="submit" disabled={busy}>{busy ? 'Joining…' : 'Join room'} <Icon name="arrow"/></button>
        <button className="text-button" type="button" onClick={() => { setView('home'); setError(''); }}>Back</button>
      </form>}
      {view === 'ended' && <div className="join-card ended-card"><span className="ended-icon"><Icon name="shield"/></span><strong>Room closed</strong><p>{error || 'This conversation has been destroyed.'}</p><button className="primary-button full-width" onClick={() => { setView('home'); setError(''); }}>Return home</button></div>}
      <div className="trust-row"><div><Icon name="shield"/><span>End-to-end encryption</span></div><div><Icon name="clock"/><span>30-minute inactivity expiry</span></div><div><Icon name="users"/><span>No accounts needed</span></div></div>
    </section>
    <footer className="site-footer"><span>hushroom</span><span>Private conversations, without the baggage.</span><a href="#privacy" onClick={(e) => { e.preventDefault(); alert('HushRoom is a starter project. Review the README security notes before production use.'); }}>Privacy notes</a></footer>
  </main>;
}
